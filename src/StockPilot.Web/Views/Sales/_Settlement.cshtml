@model DocumentDto
<h2 class="mt-4">Payment history</h2><div class="table-responsive"><table class="table"><thead><tr><th>UTC</th><th>Type</th><th>Method</th><th>Amount</th><th>Reason</th></tr></thead><tbody>@foreach(var p in Model.Payments){<tr><td>@p.CreatedUtc.ToString("yyyy-MM-dd HH:mm")</td><td>@(p.Refund?"Refund":"Payment")</td><td>@p.Method</td><td>@p.Amount.ToString("N2")</td><td>@p.Reason</td></tr>}</tbody></table></div>
<div class="no-print">@if(Model.State==DocumentState.Completed && Model.Outstanding>0){<section class="card card-body mb-3"><h2>Record payment</h2><form method="post" asp-controller="Sales" asp-action="Pay" asp-route-id="@Model.Id" class="inline-form"><input type="hidden" name="key" value="@Guid.NewGuid()"/><label>Amount <input class="form-control" name="amount" type="number" min="0.01" max="@Model.Outstanding.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.01" required/></label><label>Method <select name="method" class="form-select">@foreach(var method in Enum.GetValues<PaymentMethod>()){<option>@method</option>}</select></label><button class="btn btn-primary">Record payment</button></form></section>}
@if((User.IsInRole(Roles.Admin)||User.IsInRole(Roles.Manager))&&(Model.State==DocumentState.Completed||Model.State==DocumentState.Reversed)){<section class="card card-body mb-3"><h2>Returns & refunds</h2><p>Physical reversal returns every line to stock once and voids the receivable. It does not refund cash automatically. Refund-only entries return collected funds without moving stock; partial monetary refunds are supported.</p>@if(Model.Paid>Model.Refunded){<form method="post" asp-controller="Sales" asp-action="Refund" asp-route-id="@Model.Id" class="inline-form"><input type="hidden" name="key" value="@Guid.NewGuid()"/><label>Refund amount <input name="amount" type="number" min="0.01" max="@((Model.Paid-Model.Refunded).ToString(System.Globalization.CultureInfo.InvariantCulture))" step="0.01" class="form-control" required/></label><label>Method <select name="method" class="form-select">@foreach(var method in Enum.GetValues<PaymentMethod>()){<option>@method</option>}</select></label><label>Reason <input name="reason" required maxlength="300" class="form-control"/></label><button class="btn btn-outline-danger" data-confirm="Record this monetary refund? Stock will not change.">Record refund</button></form>}@if(Model.State==DocumentState.Completed){<form method="post" asp-controller="Sales" asp-action="Reverse" asp-route-id="@Model.Id" class="inline-form mt-3"><input type="hidden" name="key" value="@Guid.NewGuid()"/><label>Physical return reason <input name="reason" required maxlength="300" class="form-control"/></label><button class="btn btn-outline-danger" data-confirm="Confirm ALL goods were physically returned? This restores stock and voids the invoice receivable once; money is refunded separately.">Reverse entire sale / full physical return</button></form>}</section>}</div>
