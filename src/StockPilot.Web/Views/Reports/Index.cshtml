@model ReportDto
@{ViewData["Title"]="Business reports";}
<div class="toolbar"><a href="/Reports?period=day" class="btn btn-outline-secondary">Today</a><a href="/Reports?period=week" class="btn btn-outline-secondary">Last 7 days</a><a href="/Reports?period=month" class="btn btn-outline-secondary">This month</a><a href="/Inventory?low=true" class="btn btn-outline-secondary">Low-stock report</a></div><form method="get" class="toolbar"><label>From (UTC) <input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control" required/></label><label>Through (UTC) <input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control" required/></label><button class="btn btn-primary">Apply date range</button></form><p class="muted">Completion-date cohort, with current settlement and return state. Reversed sales are excluded from revenue/COGS. Payment method totals are net cash flows for this cohort. Product/category figures allocate discounts before monetary credits and may differ by rounding. Inventory valuation is current.</p>
<div class="row g-3 mb-4">@foreach(var m in new[]{("Sales subtotal",Model.SalesSubtotal),("Discounts",Model.Discounts),("Tax",Model.SalesTax),("Revenue excluding tax",Model.Revenue),("Cash refunded (including reversals)",Model.Refunds),("Net revenue after credits",Model.NetRevenue),("Historical cost of goods sold",Model.Cogs),("Gross profit estimate",Model.GrossProfitEstimate),("Received purchases including tax",Model.PurchaseTotal),("Current inventory valuation",Model.InventoryValue),("Outstanding receivables",Model.Outstanding)}){<div class="col-sm-6 col-lg-4"><div class="card card-body"><div class="metric-label">@m.Item1</div><div class="metric mono">@m.Item2.ToString("N2")</div></div></div>}</div><p>Low-stock active products: @Model.LowStock · Out of stock: @Model.OutOfStock. Gross profit excludes operating expenses and inventory adjustment losses; it is an estimate.</p>
@foreach(var group in new[]{("Daily sales",Model.Daily),("Best-selling products (top 20 by quantity)",Model.Products),("Sales by category",Model.Categories),("Payments by method (net)",Model.Methods),("Staff sales performance",Model.Staff)}){<section class="card card-body mb-4"><h2>@group.Item1</h2><div class="table-responsive"><table class="table"><thead><tr><th>Group</th><th>Amount</th><th>Quantity / count</th></tr></thead><tbody>@foreach(var x in group.Item2){<tr><td>@x.Label</td><td>@x.Amount.ToString("N2")</td><td>@x.Quantity.ToString("0.###")</td></tr>}</tbody></table>@if(group.Item2.Count==0){<p class="muted">No records for this range.</p>}</div></section>}
