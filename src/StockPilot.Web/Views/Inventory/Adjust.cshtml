@model AdjustmentInput
@{ViewData["Title"]="Adjust stock";ProductDto p=ViewBag.Product;}
<p>@p.Name · @p.Sku · Current balance: @p.Stock.ToString("0.###")</p><form method="post" asp-action="Adjust" class="card card-body form-panel"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="ProductId" type="hidden"/><input asp-for="Key" type="hidden"/><label asp-for="Change">Quantity change (positive to add, negative to remove)</label><input asp-for="Change" type="number" step="0.001" class="form-control"/><label asp-for="UnitCost">Unit cost of added stock (ignored when removing)</label><input asp-for="UnitCost" type="number" step="0.01" min="0" class="form-control"/><label asp-for="Reason">Required adjustment reason</label><textarea asp-for="Reason" class="form-control" required maxlength="300"></textarea><button class="btn btn-primary mt-3" data-confirm="Apply this stock adjustment? An immutable movement will be recorded.">Apply adjustment</button></form>
