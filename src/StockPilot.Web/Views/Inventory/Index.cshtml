@model Page<ProductDto>
@{ViewData["Title"]="Inventory balances";}
<form method="get" class="toolbar"><input name="search" value="@Context.Request.Query["search"]" class="form-control" aria-label="Search inventory" placeholder="Product or SKU"/><label><input name="low" value="true" type="checkbox" checked="@(Context.Request.Query["low"]=="true")"/> Low / out of stock</label><button class="btn btn-outline-primary">Filter</button></form><div class="table-responsive"><table class="table"><thead><tr><th>Product</th><th>Stock</th><th>Minimum</th><th>Average cost</th><th>Actions</th></tr></thead><tbody>@foreach(var p in Model.Items){<tr><td>@p.Name<br/><small>@p.Sku</small></td><td>@p.Stock.ToString("0.###")</td><td>@p.MinimumStock.ToString("0.###")</td><td>@p.AverageCost?.ToString("N6")</td><td><a class="btn btn-sm btn-outline-primary" href="/Inventory/Adjust/@p.Id">Adjust</a> <a href="/Inventory/Movements?productId=@p.Id">History</a></td></tr>}</tbody></table>@if(Model.Total==0){<div class="empty">No matching inventory balances.</div>}</div><partial name="_Pager" model="new Pager(Model.Number,Model.Size,Model.Total)"/>
