@model Page<MovementDto>
@{ViewData["Title"]="Stock movement ledger";}
<p>Every stock change is traceable. Quantities and movements are committed together.</p><div class="table-responsive"><table class="table"><thead><tr><th>UTC / product</th><th>Type / reference</th><th>Before</th><th>Change</th><th>After</th><th>Reason / actor</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.CreatedUtc.ToString("yyyy-MM-dd HH:mm")<br/>@x.Sku · @x.ProductName</td><td>@x.Type<br/>@x.DocumentNumber</td><td>@x.Before.ToString("0.###")</td><td>@x.Change.ToString("+0.###;-0.###")</td><td>@x.After.ToString("0.###")</td><td>@x.Reason<br/><small>@x.ActorId</small></td></tr>}</tbody></table>@if(Model.Total==0){<div class="empty">No stock movements yet.</div>}</div><partial name="_Pager" model="new Pager(Model.Number,Model.Size,Model.Total)"/>
