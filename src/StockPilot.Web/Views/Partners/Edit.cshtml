@model PartnerForm
@{ViewData["Title"]=(Model.Id.HasValue?"Edit ":"Add ")+Model.Kind.ToLowerInvariant();}
<form method="post" asp-action="@(Model.Id.HasValue?"Edit":"Create")" asp-route-id="@Model.Id" class="card card-body form-panel"><input asp-for="Kind" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><label asp-for="Name"></label><input asp-for="Name" class="form-control"/><label asp-for="Contact">Contact (optional)</label><input asp-for="Contact" class="form-control"/><label asp-for="Address">Address (optional)</label><textarea asp-for="Address" class="form-control"></textarea><label asp-for="Notes">Notes (optional)</label><textarea asp-for="Notes" class="form-control"></textarea><button class="btn btn-primary mt-3">Save @Model.Kind.ToLowerInvariant()</button></form>
