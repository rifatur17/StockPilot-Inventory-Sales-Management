@model Page<PartnerDto>
@{string kind=ViewBag.Kind;ViewData["Title"]=kind=="Supplier"?"Suppliers":"Customers";}
<a class="btn btn-primary mb-3" href="/Partners/Create?kind=@kind">Add @kind.ToLowerInvariant()</a><form method="get" class="toolbar"><input type="hidden" name="kind" value="@kind"/><input name="search" value="@Context.Request.Query["search"]" class="form-control" aria-label="Search partners" placeholder="Name or contact"/><label><input type="checkbox" name="archived" value="true" checked="@(Context.Request.Query["archived"]=="true")"/> Archived</label><button class="btn btn-outline-primary">Search</button></form><div class="table-responsive"><table class="table"><thead><tr><th>Name</th><th>Contact</th><th>Status</th></tr></thead><tbody>@foreach(var p in Model.Items){<tr><td><a href="/Partners/Details/@p.Id">@p.Name</a></td><td>@p.Contact</td><td>@(p.Active?"Active":"Archived")</td></tr>}</tbody></table>@if(Model.Total==0){<div class="empty">No matching @kind.ToLowerInvariant() records.</div>}</div><partial name="_Pager" model="new Pager(Model.Number,Model.Size,Model.Total)"/>
