@model DocumentDto
@inject StockPilot.Infrastructure.BusinessService Business
@{var settings=await Business.Settings(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value,Context.RequestAborted);var purchase=Model.Kind==DocumentKind.Purchase;ViewData["Title"]=purchase?"Purchase details":"Invoice";}
<article class="card card-body invoice"><div class="invoice-header"><div><h2>@settings.Name</h2><p>Currency: @settings.CurrencyCode</p><p class="muted">@Model.Number</p></div><div><span class="badge text-bg-secondary">@(purchase&&Model.State==DocumentState.Completed?"Received":Model.State.ToString())</span><p>@Model.CreatedUtc.ToString("yyyy-MM-dd HH:mm") UTC</p></div></div><p><strong>@Model.PartnerName</strong><br/>@Model.Reference</p><div class="table-responsive"><table class="table"><thead><tr><th>Item / SKU</th><th>Quantity</th><th>Unit price</th><th>Total</th></tr></thead><tbody>@foreach(var line in Model.Items){<tr><td>@line.ProductName<br/><small>@line.Sku</small></td><td>@line.Quantity.ToString("0.###")</td><td>@line.UnitPrice.ToString("N2")</td><td>@line.LineTotal.ToString("N2")</td></tr>}</tbody></table></div><dl class="row text-end"><dt class="col-8">Subtotal</dt><dd class="col-4">@Model.Subtotal.ToString("N2")</dd><dt class="col-8">Discount</dt><dd class="col-4">@Model.Discount.ToString("N2")</dd><dt class="col-8">Tax (@Model.TaxRate.ToString("0.##")%)</dt><dd class="col-4">@Model.Tax.ToString("N2")</dd><dt class="col-8">Total</dt><dd class="col-4"><strong>@Model.Total.ToString("N2")</strong></dd>@if(!purchase){<dt class="col-8">Paid / refunded</dt><dd class="col-4">@Model.Paid.ToString("N2") / @Model.Refunded.ToString("N2")</dd><dt class="col-8">Outstanding</dt><dd class="col-4">@Model.Outstanding.ToString("N2") · @Model.PaymentState</dd>}</dl><div class="toolbar no-print"><button class="btn btn-outline-secondary" type="button" data-print>Print @(purchase?"purchase":"invoice")</button>@if(Model.State==DocumentState.Draft){<form asp-controller="@(purchase?"Purchases":"Sales")" asp-action="@(purchase?"Receive":"Confirm")" asp-route-id="@Model.Id" method="post"><input type="hidden" name="key" value="@Guid.NewGuid()"/><button class="btn btn-primary" data-confirm="@(purchase?"Receive the entire purchase and increase stock?":"Confirm this sale and deduct stock?")">@(purchase?"Receive purchase":"Confirm sale")</button></form><form asp-controller="@(purchase?"Purchases":"Sales")" asp-action="Cancel" asp-route-id="@Model.Id" method="post"><input type="hidden" name="key" value="@Guid.NewGuid()"/><button class="btn btn-outline-danger" data-confirm="Cancel this unprocessed draft?">Cancel draft</button></form>}</div>
@if(!purchase){<partial name="~/Views/Sales/_Settlement.cshtml" model="Model"/>}</article>
