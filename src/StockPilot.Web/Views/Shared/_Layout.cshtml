@inject StockPilot.Infrastructure.BusinessService Workspace
@{var business=User.Identity?.IsAuthenticated==true?await Workspace.Settings(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value,Context.RequestAborted):null;}
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · StockPilot</title><link rel="stylesheet" href="~/assets/bootstrap.min.css"/><link rel="stylesheet" href="~/assets/site.css"/></head>
<body><a class="skip" href="#content">Skip to content</a><header class="topbar"><a class="brand" href="/">◈ StockPilot</a><span>Inventory &amp; Sales @business?.CurrencyCode</span>@if(User.Identity?.IsAuthenticated == true){<a href="/Account/Profile">Profile</a><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-sm btn-outline-light">Sign out</button></form>}</header>
<div class="shell">@if(User.Identity?.IsAuthenticated == true){<nav aria-label="Main navigation"><a href="/">Overview</a><a href="/Products">Products</a>@if(!User.IsInRole(Roles.Sales)){<a href="/Lookups">Categories &amp; units</a><a href="/Partners?kind=Supplier">Suppliers</a><a href="/Purchases">Purchases</a><a href="/Inventory">Inventory</a><a href="/Inventory/Movements">Stock movements</a>}@if(!User.IsInRole(Roles.Inventory)){<a href="/Partners?kind=Customer">Customers</a>}@if(!User.IsInRole(Roles.Inventory)){<a href="/Sales">Sales &amp; invoices</a><a href="/Sales/Create">Point of sale</a>}@if(User.IsInRole(Roles.Admin)||User.IsInRole(Roles.Manager)){<a href="/Reports">Reports</a><a href="/Audit">Activity log</a>}@if(User.IsInRole(Roles.Admin)){<a href="/Users">Team access</a><a href="/Settings">Business settings</a>}</nav>}
<main id="content" tabindex="-1"><div class="page-heading"><div class="eyebrow">STOCKPILOT WORKSPACE</div><h1>@ViewData["Title"]</h1></div>@if(TempData["Success"] is string message){<div class="alert alert-success" role="status">@message</div>}@RenderBody()<footer>StockPilot · All business dates and reports use UTC</footer></main></div><script src="~/assets/app.js" defer></script>@await RenderSectionAsync("Scripts", required:false)</body></html>
