@{string kind=ViewBag.Kind;}
<section id="cart" data-kind="@kind" class="row g-4"><div class="col-xl-7"><div class="card card-body"><h2>Find products</h2><form id="product-search" class="toolbar"><input id="query" class="form-control" aria-label="Search products" placeholder="Search by product, SKU or barcode"/><button class="btn btn-outline-primary">Search</button></form><div id="search-results" aria-live="polite"><p class="muted">Search to load active products.</p></div></div></div><div class="col-xl-5"><div class="card card-body"><h2>@(kind=="Purchase"?"Purchase draft":"Sales cart")</h2><div id="cart-error" role="alert" class="alert alert-danger" hidden></div><form id="cart-form"><label for="partner-query">@(kind=="Purchase"?"Supplier (required)":"Customer (optional)")</label><div class="toolbar"><input id="partner-query" class="form-control" placeholder="Search partners"/><button type="button" id="partner-search" class="btn btn-outline-secondary">Find</button></div><label for="partner" class="visually-hidden">Selected partner</label><select id="partner" class="form-select"><option value="">@(kind=="Purchase"?"Select a supplier":"Walk-in customer")</option></select><div id="cart-lines" class="mt-3"><p class="muted">Your cart is empty.</p></div><label for="discount">Document discount</label><input id="discount" type="number" min="0" step="0.01" value="0" class="form-control"/><label for="tax">Tax rate (%)</label><input id="tax" type="number" min="0" max="100" step="0.01" value="0" class="form-control"/><label for="reference">Reference (optional)</label><input id="reference" maxlength="120" class="form-control"/><p class="muted mt-3">Totals and prices are validated on the server. Review the resulting draft before @(kind=="Purchase"?"receiving":"confirmation").</p><button id="save-cart" class="btn btn-primary w-100">Create draft for review</button></form></div></div></section>
@section Scripts {<script src="~/assets/cart.js" defer></script>}
