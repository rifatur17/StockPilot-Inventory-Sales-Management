@model Page<DocumentSummary>
@{var purchase=ViewContext.RouteData.Values["controller"]?.ToString()=="Purchases";ViewData["Title"]=purchase?"Purchases":"Sales & invoices";var controller=purchase?"Purchases":"Sales";}
<a class="btn btn-primary mb-3" href="/@controller/Create">@(purchase?"New purchase":"Open point of sale")</a><form method="get" class="toolbar"><input class="form-control" name="search" value="@Context.Request.Query["search"]" placeholder="Number, partner or reference" aria-label="Search transactions"/><input type="hidden" name="partnerId" value="@Context.Request.Query["partnerId"]"/><select name="state" aria-label="Status" class="form-select"><option value="">All statuses</option>@foreach(var state in Enum.GetValues<DocumentState>()){<option selected="@(Context.Request.Query["state"]==state.ToString())">@state</option>}</select><label>From <input name="from" type="date" value="@Context.Request.Query["from"]" class="form-control"/></label><label>Through <input name="to" type="date" value="@Context.Request.Query["to"]" class="form-control"/></label><button class="btn btn-outline-primary">Filter</button></form><div class="table-responsive"><table class="table"><thead><tr><th>Number</th><th>UTC date</th><th>Partner</th><th>Status</th><th>Total</th></tr></thead><tbody>@foreach(var d in Model.Items){<tr><td><a href="/@controller/Details/@d.Id">@d.Number</a></td><td>@d.CreatedUtc.ToString("yyyy-MM-dd HH:mm")</td><td>@d.PartnerName</td><td>@(purchase&&d.State==DocumentState.Completed?"Received":d.State.ToString())</td><td>@d.Total.ToString("N2")</td></tr>}</tbody></table>@if(Model.Total==0){<div class="empty">No matching transactions. Create a draft to get started.</div>}</div><partial name="_Pager" model="new Pager(Model.Number,Model.Size,Model.Total)"/>
