@model Pager
@{var values=Context.Request.Query.ToDictionary(x=>x.Key,x=>x.Value.ToString());var pages=(int)Math.Ceiling(Model.Total/(double)Model.Size);}
<div class="toolbar muted"><span>@Model.Total records · Page @Model.Number of @Math.Max(1,pages)</span>@if(Model.Number>1){values["page"]=(Model.Number-1).ToString();<a asp-all-route-data="values" class="btn btn-sm btn-outline-secondary">Previous</a>}@if(Model.Number<pages){values["page"]=(Model.Number+1).ToString();<a asp-all-route-data="values" class="btn btn-sm btn-outline-secondary">Next</a>}</div>
