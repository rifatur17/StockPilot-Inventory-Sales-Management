@model IReadOnlyList<LookupDto>
@{ViewData["Title"]="Categories & units";var sets=new[]{("categories",Model),("units",(IReadOnlyList<LookupDto>)ViewBag.Units)};}
<div class="row g-4">@foreach(var (kind,items) in sets){<section class="col-lg-6"><div class="card card-body"><h2>@kind</h2><form method="post" asp-action="Save" class="inline-form mb-3"><input type="hidden" name="kind" value="@kind"/><input class="form-control" name="name" aria-label="New @kind name" maxlength="100" required/><button class="btn btn-primary">Add</button></form>@foreach(var x in items){<div class="toolbar"><form method="post" asp-action="Save" class="inline-form"><input type="hidden" name="kind" value="@kind"/><input type="hidden" name="id" value="@x.Id"/><input name="name" value="@x.Name" required maxlength="100" aria-label="Edit @x.Name" class="form-control"/><button class="btn btn-outline-primary">Save</button></form><form method="post" asp-action="Delete"><input type="hidden" name="kind" value="@kind"/><input type="hidden" name="id" value="@x.Id"/><button class="btn btn-outline-danger" data-confirm="Delete this lookup? Referenced records cannot be deleted.">Delete</button></form></div>}</div></section>}</div>
