@model ProductForm
@{ViewData["Title"]=Model.Id.HasValue?"Edit product":"Add product";}
<form asp-action="@(Model.Id.HasValue?"Edit":"Create")" asp-route-id="@Model.Id" method="post" class="card card-body form-panel"><div asp-validation-summary="All" class="text-danger" role="alert"></div><label asp-for="Name"></label><input asp-for="Name" class="form-control"/><div class="row"><div class="col-sm-6"><label asp-for="Sku">SKU</label><input asp-for="Sku" class="form-control"/></div><div class="col-sm-6"><label asp-for="Barcode">Barcode (optional)</label><input asp-for="Barcode" class="form-control"/></div></div><div class="row"><div class="col-sm-6"><label asp-for="CategoryId">Category</label><select asp-for="CategoryId" class="form-select"><option value="">Select category</option>@foreach(LookupDto x in ViewBag.Categories){<option value="@x.Id">@x.Name</option>}</select></div><div class="col-sm-6"><label asp-for="UnitId">Unit</label><select asp-for="UnitId" class="form-select"><option value="">Select unit</option>@foreach(LookupDto x in ViewBag.Units){<option value="@x.Id">@x.Name</option>}</select></div></div><div class="row"><div class="col-sm-6"><label asp-for="SellingPrice">Selling price</label><input asp-for="SellingPrice" type="number" min="0" step="0.01" class="form-control"/></div><div class="col-sm-6"><label asp-for="MinimumStock">Low-stock threshold</label><input asp-for="MinimumStock" type="number" min="0" step="0.001" class="form-control"/></div></div><label asp-for="Description">Description (optional)</label><textarea asp-for="Description" class="form-control"></textarea><p class="muted mt-3">Purchase cost is calculated through receipts and costed stock increases. Editing this form never changes stock or historical transactions.</p><div><button class="btn btn-primary">Save product</button> <a class="btn btn-outline-secondary" href="/Products">Cancel</a></div></form>
