@model Page<ProductDto>
@{ViewData["Title"]="Product catalog";var editable=!User.IsInRole(Roles.Sales);}
<div class="toolbar">@if(editable){<a class="btn btn-primary" href="/Products/Create">Add product</a>}<a class="btn btn-outline-secondary" href="/Products?archived=true">Archived products</a></div>
<form method="get" class="toolbar"><label class="visually-hidden" for="search">Search products</label><input class="form-control" id="search" name="search" value="@Context.Request.Query["search"]" placeholder="Name, SKU or barcode"/><select name="categoryId" aria-label="Category" class="form-select"><option value="">All categories</option>@foreach(LookupDto x in ViewBag.Categories){<option value="@x.Id" selected="@(Context.Request.Query["categoryId"]==x.Id.ToString())">@x.Name</option>}</select><select name="sort" aria-label="Sort" class="form-select"><option value="name">Name</option><option value="sku" selected="@(Context.Request.Query["sort"]=="sku")">SKU</option></select><input type="hidden" name="archived" value="@Context.Request.Query["archived"]"/><label><input type="checkbox" name="low" value="true" checked="@(Context.Request.Query["low"]=="true")"/> Low stock</label><button class="btn btn-outline-primary">Filter</button></form>
<div class="table-responsive"><table class="table"><thead><tr><th>Product</th><th>SKU</th><th>Price</th><th>Stock</th><th>Status</th></tr></thead><tbody>@foreach(var p in Model.Items){<tr><td><a href="/Products/Details/@p.Id">@p.Name</a></td><td>@p.Sku</td><td>@p.SellingPrice.ToString("N2")</td><td>@p.Stock.ToString("0.###")</td><td><span class="badge text-bg-@(p.Stock<=p.MinimumStock?"warning":"light")">@(p.Active?(p.Stock==0?"Out of stock":p.Stock<=p.MinimumStock?"Low stock":"In stock"):"Archived")</span></td></tr>}</tbody></table>@if(Model.Total==0){<div class="empty">No matching products. Add a category and unit, then create your first product.</div>}</div><partial name="_Pager" model="new Pager(Model.Number,Model.Size,Model.Total)"/>
