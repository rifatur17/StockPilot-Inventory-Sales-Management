@model ProductDto
@{ViewData["Title"]=Model.Name;}
<div class="card card-body"><div class="toolbar"><span class="badge text-bg-secondary">@Model.Sku</span><span>@(Model.Active?"Active":"Archived")</span></div><p>@Model.Description</p><dl class="row"><dt class="col-sm-3">Selling price</dt><dd class="col-sm-9">@Model.SellingPrice.ToString("N2")</dd><dt class="col-sm-3">Available stock</dt><dd class="col-sm-9">@Model.Stock.ToString("0.###")</dd><dt class="col-sm-3">Low-stock threshold</dt><dd class="col-sm-9">@Model.MinimumStock.ToString("0.###")</dd>@if(Model.AverageCost.HasValue){<dt class="col-sm-3">Average unit cost</dt><dd class="col-sm-9">@Model.AverageCost.Value.ToString("N6")</dd>}</dl>@if(!User.IsInRole(Roles.Sales)){<div class="toolbar"><a class="btn btn-primary" href="/Products/Edit/@Model.Id">Edit product</a><a class="btn btn-outline-secondary" href="/Inventory/Movements?productId=@Model.Id">Stock history</a>@if(Model.Active){<form method="post" asp-action="Archive" asp-route-id="@Model.Id"><button class="btn btn-outline-danger" data-confirm="Archive this product? Remaining stock must be zero.">Archive</button></form>}</div>}</div>
