@model LoginForm
@{ViewData["Title"]="Welcome back";}
<div class="auth-card card"><div class="card-body"><h2>Sign in to your workspace</h2><p class="text-secondary">Keep your inventory, sales and team in sync.</p><form method="post" asp-action="Login"><div asp-validation-summary="All" class="text-danger" role="alert"></div><label asp-for="Email"></label><input asp-for="Email" class="form-control" autocomplete="username"/><label asp-for="Password"></label><input asp-for="Password" class="form-control" autocomplete="current-password"/><button class="btn btn-primary mt-3 w-100">Sign in</button></form></div></div>
