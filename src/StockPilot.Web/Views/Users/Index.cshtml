@model IReadOnlyList<UserDto>
@{ViewData["Title"]="Team access";}
<p>One role per account. Role/status changes revoke existing sessions. At least one active administrator must remain.</p><a class="btn btn-primary mb-3" href="/Users/Create">Add team member</a><div class="table-responsive"><table class="table"><thead><tr><th>Name</th><th>Email</th><th>Access</th></tr></thead><tbody>@foreach(var u in Model){<tr><td>@u.DisplayName</td><td>@u.Email</td><td><form method="post" asp-action="Change" class="inline-form"><input type="hidden" name="id" value="@u.Id"/><select name="role" aria-label="Role for @u.DisplayName" class="form-select">@foreach(var role in Roles.All){<option selected="@(u.Roles.Contains(role))">@role</option>}</select><label><input type="checkbox" name="active" value="true" checked="@u.Active"/> Active</label><button class="btn btn-outline-primary" data-confirm="Change access and revoke this user's sessions?">Save</button></form></td></tr>}</tbody></table></div>
