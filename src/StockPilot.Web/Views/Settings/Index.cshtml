@model SettingsInput
@{ViewData["Title"]="Business settings";}
<form method="post" asp-action="Index" class="card card-body form-panel"><div asp-validation-summary="All" class="text-danger"></div><label asp-for="Name">Business name</label><input asp-for="Name" class="form-control"/><label asp-for="CurrencyCode">Ledger currency (three-letter code)</label><input asp-for="CurrencyCode" class="form-control" maxlength="3"/><p class="muted mt-3">Choose your business currency before creating transactions. It cannot change once any document exists. All amounts use this one currency, with two-decimal monetary precision. This release has no currency conversion.</p><button class="btn btn-primary">Save settings</button></form>
