@model Overview
@{ViewData["Title"]="Business overview";}
<p class="muted">Your workspace at a glance. Every figure comes from persisted business records.</p>
@if(Model.Report is {} r){<div class="row g-3 mb-4">@foreach(var metric in new[]{("Net revenue · last 30 days",r.NetRevenue.ToString("N2")),("Gross profit estimate",r.GrossProfitEstimate.ToString("N2")),("Current stock valuation",r.InventoryValue.ToString("N2")),("Low / out of stock",r.LowStock+" / "+r.OutOfStock)}){<div class="col-sm-6 col-xl-3"><div class="card card-body"><div class="metric-label">@metric.Item1</div><div class="metric mono">@metric.Item2</div></div></div>}</div><div class="row g-4"><section class="col-lg-8"><div class="card card-body"><h2>Net sales revenue · UTC</h2>@if(r.Daily.Count==0){<div class="empty">No completed sales in this period.</div>}else{var max=Math.Max(1,r.Daily.Max(x=>x.Amount));<svg viewBox="0 0 600 100" role="img" aria-label="Daily net revenue trend" class="stat-chart"><polyline fill="none" stroke="currentColor" stroke-width="3" points="@string.Join(" ",r.Daily.Select((x,i)=>$"{(r.Daily.Count==1?300:i*590m/(r.Daily.Count-1)).ToString("0.##",System.Globalization.CultureInfo.InvariantCulture)},{(95-x.Amount/max*85).ToString("0.##",System.Globalization.CultureInfo.InvariantCulture)}"))"/>@if(r.Daily.Count==1){var point=r.Daily[0];<circle cx="300" cy="@((95-point.Amount/max*85).ToString("0.##",System.Globalization.CultureInfo.InvariantCulture))" r="5" fill="currentColor"><title>@point.Label: @point.Amount.ToString("N2")</title></circle>}</svg><p class="muted">@r.From.ToString("dd MMM") – @r.To.ToString("dd MMM yyyy") · after monetary credits, excluding tax</p>}<a href="/Reports">Explore reports →</a></div></section><section class="col-lg-4"><div class="card card-body"><h2>Quick actions</h2><a class="btn btn-primary mb-2" href="/Sales/Create">Open point of sale</a><a class="btn btn-outline-primary mb-2" href="/Purchases/Create">Receive a purchase</a><a href="/Inventory?low=true">Review low-stock products →</a></div></section></div>}
else if(Model.LowStock is {} stock){<div class="card card-body"><h2>Replenishment queue · @stock.Total products</h2><p>Active products at or below their reorder threshold.</p>@foreach(var p in stock.Items){<p><a href="/Products/Details/@p.Id">@p.Name</a> · @p.Stock.ToString("0.###") available</p>}<a href="/Inventory?low=true">View low-stock inventory →</a></div>}
else if(Model.Sales is {} sales){<div class="toolbar"><a class="btn btn-primary" href="/Sales/Create">Start a sale</a><a href="/Sales">All your invoices (@sales.Total)</a></div><div class="card card-body"><h2>Your recent invoices</h2>@if(sales.Items.Count==0){<p>No sales yet. Open the POS to create your first draft.</p>}@foreach(var d in sales.Items){<p><a href="/Sales/Details/@d.Id">@d.Number</a> · @d.State · @d.Total.ToString("N2")</p>}</div>}
